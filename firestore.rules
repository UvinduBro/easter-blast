rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /nodes/{nodeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /edges/{edgeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /pageContent/{slug} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
